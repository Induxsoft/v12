#include "dkli.dkh"
#!
module ""
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "webcl.dkh"
    #include "version.dkl"
    #include "dbm.dkl"
    #include "ddm.json.dkl"
    #include "ddm.mysql.dkl"

    parse.json::json
    {
        return from.json(json)

        exception{return @null}
    }
    search.manifest::id_pack
    {
        filename=id_pack+".manifest"
        file_path=path.concat(@path_dir,filename)

        do Log(">> Obtener manifiesto de:"+file_path )

        if not(file.exists(file_path)){return @null}

        return parse.json(file.rtext(file_path))
    }
    //obtener paquete y version de la base de datos
    get.pack::id_pack
    {
        for i = 0; i < @count(@paquetes)
        {
            ref p=@item(@paquetes,i)
            id=trim(@@(p,"$pack_id"))
            if id_pack == id{return p}
        }

        return @null
    }
    install.pack::&lista
    {
        packs_to_install=""
        for i = 0; i < @count(lista)
        {
            pack=list.str(lista,i)
            id_pack=replace(pack,file.extension(pack),"")
            ref manifest=search.manifest(id_pack)

            if trim(@@(manifest,"$id")) !=""
            {
                do Log(">> Manifiesto encontrado: "+id_pack)
                packs_to_install=packs_to_install+id_pack +","
                ref pack_obj=get.pack(pack)
                
                if not(isnull(pack_obj))
                {
                    version=@@(manifest,"$version")
                    version_manifest=@@(@manifiesto,"$version")

                    version_schema=@@(pack_obj,"$schema_ver")
                    version_schema_manifest=@@(@manifiesto,"$schema_ver")

                    if not(@deploy_pack)
                    {
                        //verificar si hacer deploya al paquete
                        @deploy_pack=version.compare(version,version_manifest) == 2
                    }
                    if not(@install_pack)
                    {
                        @install_pack=version.compare(version_schema,version_schema_manifest) == 2
                    }
                    do Log(">> Version código fuente: "+version +" manifiesto: "+version_manifest)
                    do Log(">> Version schema: "+version_schema +" manifiesto: "+version_schema_manifest)
                    // if @deploy_pack && @install_pack{return @true}
                }
            }
            else
            {
                do Log(">>> Manifiesto no encontrado del paquete: "+pack)
            }
        }

        if packs_to_install !=""{return rremove(packs_to_install,1)}

        return packs_to_install
    }
    
    deploy_packs::&params
    {
        packs=trim(@@(params,"$packs"))
        src_url=@source_url
        cat_f=@cat_file
        cmd = ftext('deployv12 packs="#<packs>" from="#<src_url>" cat="#<cat_f>" -hide-log')
        // res = exec(@devkron,cmd,@true)
        res=_exec(@devkron,cmd,@true,@exec_timeout,@false)
    }
    install_pakcs::&db,&params
    {
        packs=trim(@@(params,"$packs"))
        qname=trim(@@(params,"$qname"))
        if qname ==""{qname=dbr.full_qname(db)}
        src_url=@source_url
        cat_f=@cat_file

        cmd = ftext('installv12 db="#<qname>" packs="#<packs>" from="#<src_url>" cat="#<cat_f>" -hide-log')
        res=_exec(@devkron,cmd,@true,@exec_timeout,@false)
    }
    ref @buffer=text.create()
    Log::txt
    {
        do print(txt)
        do text.say(@buffer,txt)
    }

    saveLog::path
    {
        if path == ""{return}

        do file.wtext(path,text.get(@buffer))
    }
    parse.qname::qname
    {
        qname=replace(qname,"\\","/")
        if not(contains(qname,"/")){return qname}

        ref s=split(qname,"/")

        return list.str(s,1)
    }

    // ---- Sitios conectados a la base: updatesite (paquete dkl-web) ----
    // connectv12 escribe _config/<host>.json con {"qname": "<conexión>"}; el sitio vive en web/<host>.
    update.sitio::host
    {
        sitio=path.concat(@sites_path,host)
        if not(dir.exists(sitio))
        {
            do Log(">> Sitio "+host+": no existe "+sitio)
            return 0
        }

        // Plantilla: la del registro de updatesite; sin registro, se deduce del contenido
        plantilla=""
        reg=path.concat(sitio,"_protected/site.installed.json")
        if file.exists(reg)
        {
            ref r=parse.json(file.rtext(reg))
            if not(isnull(r)) { plantilla=trim(@@(r,"$template")) }
        }
        if plantilla==""
        {
            if file.exists(path.concat(sitio,"_protected/render.dk"))
            {
                plantilla="v12"
            }
            else if file.exists(path.concat(sitio,"index.dkl"))
            {
                plantilla="v12-content-site"
            }
        }
        if plantilla==""
        {
            do Log(">> Sitio "+host+": no se reconoce su plantilla; no se actualiza")
            return 0
        }
        if not(file.exists(path.concat(path.concat(@templates_path,plantilla),"site.manifest")))
        {
            do Log(">> Sitio "+host+": la plantilla "+plantilla+" no tiene site.manifest; no se actualiza")
            return 0
        }

        do Log(">> Sitio "+host+": updatesite "+plantilla)
        cmd=ftext('updatesite "#<plantilla>" "#<host>" -hide-log')
        res=_exec(@devkron,cmd,@true,@exec_timeout,@false)
        do Log(res)
        if findstr(res,"RESULTADO: OK")<0
        {
            @sitios_con_error=@sitios_con_error+1
            do Log(">> Sitio "+host+": updatesite terminó con errores o no terminó; revise el reporte de arriba")
        }
        return 0
    }

    update.sitios::qname_db
    {
        if not(dir.exists(@sites_cfg))
        {
            do Log(">> Sin carpeta "+@sites_cfg+": no hay sitios conectados")
            return 0
        }
        if not(file.exists("updatesite.dkl"))
        {
            do Log(">> No está updatesite.dkl (paquete dkl-web): los sitios no se actualizan")
            return 0
        }

        ref cfgs=list.files(@sites_cfg,"*.json")
        n=0
        for i=0;i<@count(cfgs)
        {
            archivo=list.str(cfgs,i)
            host=file.justname(archivo)
            cq=""
            ref cfg=parse.json(file.rtext(archivo))
            if not(isnull(cfg)) { cq=trim(@@(cfg,"$qname")) }
            if tolower(cq)==tolower(qname_db)
            {
                n=n+1
                do update.sitio(host)
            }
            exception
            {
                do Log(">> Error con "+archivo+": "+last_error())
            }
        }
        do Log(">> Sitios conectados a "+qname_db+": "+str(n)+", con errores: "+str(@sitios_con_error))
        return 0
    }

    if isset("@context"){ref args=@context}
    else{ref args=commandline("=")}
    
    @path_log="/usr/data/outputs/updatev12/logs/"
    @source_url="https://install-v12.induxsoft.net/"
    @cat_file="catalog.json"
    @manifest_file="manifest.json"
    @file_ext=".zip"
    @devkron="./dkl"
    @templates_path="_templates/sites"
    @sites_path="web"
    @sites_cfg="_config"
    @sitios_con_error=0

    qname=trim(@@(args,"$db"))
    from=trim(@@(args,"$from"))
    path_log=trim(@@(args,"$path_log"))
    if qname == ""{qname=trim(@@(args,"$qname"))}
    if qname == ""{do rise_error(99,"No ha indicado una conexión `qname` ")}
    if path_log !=""{@path_log=path_log}
    
    @path_log=@path_log+parse.qname(qname)+"_"+date_str(now(),"yyyy-MM-dd")+".log"

    if trim(@@(args,"$from"))!="" { @source_url=trim(@@(args,"$from")) }
    if trim(@@(args,"$cat"))!="" { @cat_file=trim(@@(args,"$cat")) }
    if trim(@@(args,"$path_dkl")) != ""{@devkron=trim(@@(args,"$path_dkl"))}

    args<"qname">:qname

    @path_root="_deployed"

    do Log("=======================INICIO========================")
    do Log("> Abrir base de datos")
    ref db=dbr.open(qname)

    do Log(">> Crear tabla de logs si no existe")
    module "Crear tabla de log"
    {
        do dbm.checkLogTables(db)
        exception{do Log(">>" + last_error())}
    }
    

    do Log("> Obtener paquetes instalados")
    ref @paquetes=dbr.list(db,"SELECT DISTINCT
            COALESCE(p.pack, a.pack_id) AS pack_id,

            COALESCE(
                p.schema_ver,
                ''
            ) AS schema_ver,

            (
                SELECT trim(l.sys_dtcreated)
                FROM sys_model_log l
                WHERE l.source LIKE CONCAT('%', COALESCE(p.pack, a.pack_id), '%')
                ORDER BY l.sys_dtcreated DESC
                LIMIT 1
            ) AS last_install

        FROM sys_app_catalog a
        LEFT JOIN sys_packs p 
        ON p.pack = a.pack_id;",@null)

    // descargar archivo de manifiesto
    
    do Log("Paquetes instalados: "+str(@count(@paquetes)))

    do Log("> Descargar manifiesto desde: "+@source_url)

    ref @manifest_packs=from.json(http.get(@source_url+@manifest_file))

    do Log("> Manifiesto descargado")

    md5_url=md5(@source_url)
    @path_dir=path.concat(@path_root,md5_url)

    for i=0;i< @count(@paquetes)
    {
        ref paquete=@item(@paquetes,i)
        @deploy_pack=@false
        @install_pack=@false
        //buscar el archivo .manifest 
        id_pack=trim(@@(paquete,"$pack_id"))
        ref @manifiesto=@@(@manifest_packs,"&"+id_pack)
        do Log(">> Verificar manifiesto del paquete: "+id_pack)

        ref manifest=search.manifest(id_pack)
        // verificar las versiones 
        if isnull(manifest)
        {
            do Log(">> No se econtró el manifiesto de: "+id_pack)
            do Log(">> Buscar manifiesto del archivo "+@cat_file)
            //obtener el nombre el archivo zip de catalog
            file_path_catalog=path.concat(@path_dir,@cat_file)
            do Log(">> Buscar archivo: "+file_path_catalog)
            if file.exists(file_path_catalog)
            {
                do Log(">> Archivo entoncontrado: "+file_path_catalog)
                ref catalog=parse.json(file.rtext(file_path_catalog))
                ref cat_items=@@(catalog,"&"+id_pack)
                do Log(">> Verficar si el paquete requiere deploy o instalación")
                ids_packs= install.pack(cat_items)
                if ids_packs == ""
                {
                    @deploy_pack=@true
                    @install_pack=@true
                }
                else
                {
                    id_pack=id_pack+","+ids_packs
                }
            }
            else
            {
                //Nunca se desplegó desde esta fuente: la versión local es desconocida
                do Log(">> Sin despliegues desde esta fuente: versión local desconocida")
                @deploy_pack=not(isnull(@manifiesto))
                @install_pack=@deploy_pack
            }
        }
        else
        {
            version=@@(manifest,"$version")
            version_manifest=@@(@manifiesto,"$version")

            version_schema=@@(paquete,"$schema_ver")
            version_schema_manifest=@@(@manifiesto,"$schema_ver")

            do Log(">> Manifiesto encontrado: "+id_pack)
            do Log(">> Version código fuente: "+version +" manifiesto: "+version_manifest)
            do Log(">> Version schema: "+version_schema +" manifiesto: "+version_schema_manifest)

            @deploy_pack=version.compare(version,version_manifest) == 2
            @install_pack=version.compare(version_schema,version_schema_manifest) == 2

            if version_schema_manifest == ""{@install_pack=@true}
        }
        do Log(">> Requiere deploy: "+ifstr(@deploy_pack,'SÍ','NO'))
        do Log(">> Requiere instalación: "+ifstr(@install_pack,'SÍ','NO'))
        //hacer deploy si es necesario 
        args<"packs">:id_pack
        if @deploy_pack 
        {
            do Log(">> Haciendo deploy de: "+id_pack)
            do deploy_packs(args)
        }
        if @install_pack
        {
            do Log(">> Realizando instalación de: "+id_pack)
            do install_pakcs(db,args)
        }

        exception
        {
            do Log("Error: "+last_error())
        }

        do Log("\n\n")
    }

    // Después de desplegar: llevar los sitios conectados a la base a su plantilla actual
    if field.exist(args,"sinsitios")
    {
        do Log("> Sitios: no se actualizan (sinsitios)")
    }
    else
    {
        do Log("> Actualizar sitios conectados a "+qname)
        codeblock
        {
            do update.sitios(qname)
            exception { do Log(">> Error al actualizar sitios: "+last_error()) }
        }
    }
    
    exception
    {
        do Log("Error ocurrido: "+last_error())
    }

    if isset("@context"){@context<"status">:"finished"}
    
    if isset("db"){do dbr.close(db)}

    do saveLog(@path_log)
}